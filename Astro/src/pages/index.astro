---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cta from '../components/Cta.astro';
import Faq from '../components/Faq.astro';
import ArrowButton from '../components/ui/ArrowButton.astro';
import Button from '../components/ui/Button.astro';
import config from '../config/config.json';
import { getServices, serviceUrl, getArticles, articleUrl, formatDate } from '../lib/content';

const pageId = config.webflow.pages.home;

// SEC / 03 Service — one slide per service (Webflow: limit 1 / offset N per slide).
const services = (await getServices()).slice(0, 5);

// SEC / 09 Newsroom — one slide per article, newest five (Webflow: limit 1 / offset N per slide).
const newsroomArticles = (await getArticles()).slice(0, 5);
const newsroomSlides = newsroomArticles.length ? newsroomArticles.map((a) => [a]) : [[]];
