---
/**
 * Base document for every page.
 *
 * `pageId` is the Webflow page id the interactions in `public/js/webflow.js` are bound to.
 * Keep the id of the page you copied a layout from, otherwise its scroll/hover animations
 * will not run (ids live in `src/config/config.json` → `webflow.pages`).
 */
import SeoMeta from '../components/SeoMeta.astro';
import config from '../config/config.json';
import interactionsCss from '../styles/interactions.css?raw';
import '../styles/normalize.css';
import '../styles/webflow.css';
import '../styles/theme.css';
import '../styles/lenis.css';

interface Props {
  pageId: string;
  title?: string;
  fullTitle?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const { pageId, ...seo } = Astro.props;
---

<!doctype html>
<html data-wf-page={pageId} lang={config.site.lang} data-form-endpoint={config.forms.endpoint}>
  <head>
    <meta charset="utf-8" />
    <SeoMeta {...seo} />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <meta name="generator" content={Astro.generator} />
    <style is:inline set:html={interactionsCss} />
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin="anonymous" />
    <script is:inline src="/js/vendor/webfont.js"></script>
    <script is:inline>WebFont.load({ google: { families: ['IBM Plex Mono:400,500,600,700'] } });</script>
    <script is:inline>!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>
    <link href="/images/favicon.png" rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: light)" />
    <link href="/images/favicon-dark.png" rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: dark)" />
    <link href="/images/favicon-48.png" rel="icon" type="image/png" sizes="48x48" />
    <link href="/images/webclip-180.png" rel="apple-touch-icon" sizes="180x180" />
    <link href="/images/webclip-192.png" rel="icon" type="image/png" sizes="192x192" />
    <link href="/images/webclip.png" rel="icon" type="image/png" sizes="512x512" />
  </head>
  <body>
    <slot />
    <script is:inline src="/js/forms.js"></script>
    <script is:inline src="/js/vendor/jquery-3.5.1.min.js"></script>
    <script is:inline src="/js/webflow.js"></script>
    <script is:inline src="/js/vendor/gsap.min.js"></script>
    <script is:inline src="/js/vendor/SplitText.min.js"></script>
    <script is:inline src="/js/vendor/ScrollTrigger.min.js"></script>
    <script is:inline src="/js/vendor/lenis.min.js"></script>
    <script is:inline src="/js/main.js"></script>
  </body>
</html>
