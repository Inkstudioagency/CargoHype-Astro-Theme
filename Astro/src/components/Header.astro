---
/**
 * Site header: utility bar + two navbars (light over the hero, dark once scrolled —
 * the swap is driven by the Webflow interactions). Links come from `src/config/menu.json`.
 */
import config from '../config/config.json';
import menu from '../config/menu.json';
import ArrowButton from './ui/ArrowButton.astro';

const { site } = config;
const trim = (url: string) => url.replace(/\/$/, '') || '/';
const path = trim(Astro.url.pathname);
const isHome = path === '/';
const isActive = (url: string) => path === trim(url);
---

<div data-wf-component-id="68ec4265-ffff-df33-b3ea-11a0eaec8712" data-wf-variant-state="base" class="nav-wrapper">
  <div class="utility-bar-wrap">
    <section class="utility-bar">
      <div class="utility-item hide-tab">
        <div class="utility-icon w-embed"><svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 3L20 7.5V16.5L12 21L4 16.5V7.5L12 3Z" stroke="#EA580C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M12 12L20 7.5" stroke="#EA580C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M12 12V21" stroke="#EA580C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M12 12L4 7.5" stroke="#EA580C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M16 5.25L8 9.75" stroke="#EA580C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg></div>
        <div class="utility-text">Real-time tracking</div>
      </div>
      <div class="utility-divider"></div>
      <div class="utility-item hide-tab">
        <div class="utility-icon w-embed"><svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M5.58579 18.4142C5.21071 18.0391 5 17.5304 5 17C5 16.4696 5.21071 15.9609 5.58579 15.5858C5.96086 15.2107 6.46957 15 7 15C7.53043 15 8.03914 15.2107 8.41421 15.5858C8.78929 15.9609 9 16.4696 9 17C9 17.5304 8.78929 18.0391 8.41421 18.4142C8.03914 18.7893 7.53043 19 7 19C6.46957 19 5.96086 18.7893 5.58579 18.4142Z" stroke="#EA580C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M15 17C15 17.5304 15.2107 18.0391 15.5858 18.4142C15.9609 18.7893 16.4696 19 17 19C17.5304 19 18.0391 18.7893 18.4142 18.4142C18.7893 18.0391 19 17.5304 19 17C19 16.4696 18.7893 15.9609 18.4142 15.5858C18.0391 15.2107 17.5304 15 17 15C16.4696 15 15.9609 15.2107 15.5858 15.5858C15.2107 15.9609 15 16.4696 15 17Z" stroke="#EA580C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M5 17H3V13M2 5H13V17M9 17H15M13 6H18L21 11V17H19M21 11H13" stroke="#EA580C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M3 9H7" stroke="#EA580C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg></div>
        <div class="utility-text">Fast and easy delivery</div>
      </div>
      <div class="utility-divider"></div>
      <div class="utility-item hide-tab">
        <div class="utility-icon w-embed"><svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M20.9463 12.99C21.1444 11.2006 20.8013 9.39285 19.9613 7.80047C19.1212 6.20809 17.823 4.90424 16.2342 4.05743C14.6454 3.21062 12.8392 2.85977 11.0489 3.05023C9.25863 3.24068 7.56663 3.96369 6.19157 5.12581C4.81651 6.28792 3.82158 7.83573 3.33538 9.5692C2.84918 11.3027 2.89404 13.1421 3.46418 14.8498C4.03431 16.5575 5.10351 18.055 6.5336 19.1487C7.96368 20.2424 9.68891 20.8821 11.4863 20.985" stroke="#EA580C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M3.59961 9H20.3996" stroke="#EA580C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M3.59961 15H17.4996" stroke="#EA580C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M11.4997 3C9.81501 5.69961 8.92188 8.81787 8.92188 12C8.92188 15.1821 9.81501 18.3004 11.4997 21" stroke="#EA580C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M12.5 3C14.7316 6.57544 15.5552 10.8525 14.811 15.001" stroke="#EA580C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M15 19L17 21L21 17" stroke="#EA580C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg></div>
        <div class="utility-text">World wide network</div>
      </div>
      <div data-delay="4000" data-animation="slide" class="nav-top-slider-block w-slider" data-autoplay="false" data-easing="ease" data-hide-arrows="false" data-disable-swipe="false" data-autoplay-limit="0" data-nav-spacing="3" data-duration="500" data-infinite="true">
        <div class="nav-top-slider-mask w-slider-mask">
          <div class="nav-top-slide w-slide">
            <div class="utility-item">
              <div class="utility-icon w-embed"><svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 3L20 7.5V16.5L12 21L4 16.5V7.5L12 3Z" stroke="#EA580C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  <path d="M12 12L20 7.5" stroke="#EA580C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  <path d="M12 12V21" stroke="#EA580C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  <path d="M12 12L4 7.5" stroke="#EA580C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  <path d="M16 5.25L8 9.75" stroke="#EA580C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg></div>
              <div class="utility-text">Real-time tracking</div>
            </div>
          </div>
          <div class="nav-top-slide w-slide">
            <div class="utility-item">
              <div class="utility-icon w-embed"><svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M5.58579 18.4142C5.21071 18.0391 5 17.5304 5 17C5 16.4696 5.21071 15.9609 5.58579 15.5858C5.96086 15.2107 6.46957 15 7 15C7.53043 15 8.03914 15.2107 8.41421 15.5858C8.78929 15.9609 9 16.4696 9 17C9 17.5304 8.78929 18.0391 8.41421 18.4142C8.03914 18.7893 7.53043 19 7 19C6.46957 19 5.96086 18.7893 5.58579 18.4142Z" stroke="#EA580C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  <path d="M15 17C15 17.5304 15.2107 18.0391 15.5858 18.4142C15.9609 18.7893 16.4696 19 17 19C17.5304 19 18.0391 18.7893 18.4142 18.4142C18.7893 18.0391 19 17.5304 19 17C19 16.4696 18.7893 15.9609 18.4142 15.5858C18.0391 15.2107 17.5304 15 17 15C16.4696 15 15.9609 15.2107 15.5858 15.5858C15.2107 15.9609 15 16.4696 15 17Z" stroke="#EA580C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  <path d="M5 17H3V13M2 5H13V17M9 17H15M13 6H18L21 11V17H19M21 11H13" stroke="#EA580C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  <path d="M3 9H7" stroke="#EA580C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg></div>
              <div class="utility-text">Fast and easy delivery</div>
            </div>
          </div>
          <div class="nav-top-slide w-slide">
            <div class="utility-item">
              <div class="utility-icon w-embed"><svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M20.9463 12.99C21.1444 11.2006 20.8013 9.39285 19.9613 7.80047C19.1212 6.20809 17.823 4.90424 16.2342 4.05743C14.6454 3.21062 12.8392 2.85977 11.0489 3.05023C9.25863 3.24068 7.56663 3.96369 6.19157 5.12581C4.81651 6.28792 3.82158 7.83573 3.33538 9.5692C2.84918 11.3027 2.89404 13.1421 3.46418 14.8498C4.03431 16.5575 5.10351 18.055 6.5336 19.1487C7.96368 20.2424 9.68891 20.8821 11.4863 20.985" stroke="#EA580C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  <path d="M3.59961 9H20.3996" stroke="#EA580C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  <path d="M3.59961 15H17.4996" stroke="#EA580C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  <path d="M11.4997 3C9.81501 5.69961 8.92188 8.81787 8.92188 12C8.92188 15.1821 9.81501 18.3004 11.4997 21" stroke="#EA580C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  <path d="M12.5 3C14.7316 6.57544 15.5552 10.8525 14.811 15.001" stroke="#EA580C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  <path d="M15 19L17 21L21 17" stroke="#EA580C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg></div>
              <div class="utility-text">World wide network</div>
            </div>
          </div>
        </div>
        <div class="nav-top-slider-arrow w-slider-arrow-left">
          <div class="nav-top-slider-arrow-icon w-icon-slider-left"></div>
        </div>
        <div class="nav-top-slider-arrow w-slider-arrow-right">
          <div class="nav-top-slider-arrow-icon w-icon-slider-right"></div>
        </div>
        <div class="display-none w-slider-nav w-round w-num"></div>
      </div>
    </section>
  </div>
  <div class="nav-wrap">
    <div data-animation="default" data-collapse="medium" data-duration="400" data-easing="ease" data-easing2="ease" role="banner" class="navbar is-one w-nav">
      <div class="container w-container">
        <div class="nav-item-wrap">
          <a href="/" aria-current={isHome ? 'page' : undefined} class:list={['brand-link w-nav-brand', isHome && 'w--current']}><img loading="lazy" src={site.logo} alt={site.logo_alt} class="brand-logo is-one"></a>
          <nav role="navigation" class="nav-menu-main w-nav-menu">
            <div class="nav-menu">
            {menu.main.map((item) => (
              <a href={item.url} aria-current={isActive(item.url) ? 'page' : undefined} class:list={['nav-link', isActive(item.url) && 'w--current']}>{item.name}</a>
            ))}
          </div>
          </nav>
          <div class="nav-button-wrap">
            <div class="navigation-button-wrap is-one">
              <ArrowButton href={menu.cta.url} label={menu.cta.name} variant="base" />
            </div>
          </div>
          <div class="menu-button w-nav-button">
            <div class="w-icon-nav-menu"></div>
          </div>
        </div>
      </div>
    </div>
    <div data-animation="default" data-collapse="medium" data-duration="400" data-easing="ease" data-easing2="ease" role="banner" class="navbar is-two w-nav">
      <div class="container w-container">
        <div class="nav-item-wrap">
          <a href="/" aria-current={isHome ? 'page' : undefined} class:list={['brand-link w-nav-brand', isHome && 'w--current']}><img loading="lazy" src={site.logo_dark} alt={site.logo_dark_alt} class="brand-logo is-one"></a>
          <nav role="navigation" class="nav-menu-main w-nav-menu">
            <div class="nav-menu">
            {menu.main.map((item) => (
              <a href={item.url} aria-current={isActive(item.url) ? 'page' : undefined} class:list={['navlink-black', isActive(item.url) && 'w--current']}>{item.name}</a>
            ))}
          </div>
          </nav>
          <div class="nav-button-wrap">
            <div class="navigation-button-wrap is-one">
              <ArrowButton href={menu.cta.url} label={menu.cta.name} variant="brand" />
            </div>
          </div>
          <div class="menu-button w-nav-button">
            <div class="w-icon-nav-menu"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
