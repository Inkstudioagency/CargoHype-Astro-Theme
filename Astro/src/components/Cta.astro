---
/** Closing call-to-action band shown above the footer on most pages. */
import ArrowButton from './ui/ArrowButton.astro';
---

<section class="section cta">
  <div class="section-gap cta">
    <div class="w-layout-blockcontainer container w-container">
      <div class="cta-wrapper">
        <div class="cta-content">
          <div class="cta-text-block">
            <div class="cta-badge">
              <div class="badge-dot"></div>
              <div class="hero-badge-text">SEC / 10 Let&#x27;s Connect</div>
            </div>
            <h2 class="cta-title">Ready to move? Get a routed quote in one business day.</h2>
            <p class="cta-paragraph">Tell us what you&#x27;re shipping and where it needs to be. A coordinator — not a bot — will reply with routing options and a landed cost.</p>
            <div class="cta-button-wrap">
              <ArrowButton href="/contact" label="Request a quote" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
